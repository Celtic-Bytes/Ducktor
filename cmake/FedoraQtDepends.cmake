# Qt plugins and QML modules are loaded at runtime, so the automatic requires
# generated by rpmbuild cannot see them. Ask rpm which installed packages
# provide the ones Ducktor needs and add them to the RPM dependencies: the QML
# modules by their qt6qml() capability (the one Fedora's qt6 packages
# advertise) and the plugins by the package that owns the file.
find_program(DUCKTOR_RPM rpm)
if(NOT DUCKTOR_RPM OR NOT QT6_INSTALL_PREFIX)
    return()
endif()

set(_plugins ${QT6_INSTALL_PREFIX}/${QT6_INSTALL_PLUGINS})
set(_qml ${QT6_INSTALL_PREFIX}/${QT6_INSTALL_QML})
file(GLOB _plugin_files
    ${_plugins}/imageformats/libqsvg.so
    ${_plugins}/multimedia/*.so
    ${_plugins}/platforms/libqxcb.so
    ${_plugins}/platforms/libqwayland*.so)
set(_requires)
foreach(path IN LISTS _plugin_files)
    execute_process(COMMAND ${DUCKTOR_RPM} -q --qf %{NAME} -f ${path}
        OUTPUT_VARIABLE _package OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE _result ERROR_QUIET)
    if(_result EQUAL 0)
        list(APPEND _requires ${_package})
    endif()
endforeach()
foreach(module IN ITEMS
        QtQuick QtQuick/Controls QtQuick/Controls/Fusion QtQuick/Layouts QtQuick/Templates QtQuick/Window
        QtQuick/Dialogs QtQuick/Dialogs/quickimpl QtQml/WorkerScript Qt/labs/folderlistmodel)
    if(EXISTS ${_qml}/${module}/qmldir)
        string(REPLACE "/" "." _capability ${module})
        # Quoted: unquoted parentheses would split the name into list items.
        set(_capability "qt6qml(${_capability})")
        execute_process(COMMAND ${DUCKTOR_RPM} -q --whatprovides ${_capability}
            RESULT_VARIABLE _result ERROR_QUIET)
        if(_result EQUAL 0)
            list(APPEND _requires ${_capability})
        endif()
    endif()
endforeach()

if(_requires)
    list(REMOVE_DUPLICATES _requires)
    list(SORT _requires)
    list(JOIN _requires " " CPACK_RPM_PACKAGE_REQUIRES)
    message(STATUS "Extra RPM requires: ${CPACK_RPM_PACKAGE_REQUIRES}")
else()
    message(STATUS "Qt is not from rpm packages: the RPM will only list the libraries found by the automatic requires.")
endif()
