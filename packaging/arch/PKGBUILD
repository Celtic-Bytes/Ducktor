# Maintainer: celticbytes <info@celticbytes.com>
#
# Builds Ducktor from source. The inference engines (llama.cpp, whisper.cpp,
# Piper) are cloned and compiled during the build, so it needs network access
# and a while to finish. When a new release tag is cut, bump pkgver and
# recalculate sha256sums from the tarball at
# https://github.com/Celtic-Bytes/Ducktor/archive/refs/tags/v<pkgver>.tar.gz

pkgname=ducktor
pkgver=0.2.1
pkgrel=1
pkgdesc="Offline desktop translator for text and voice"
arch=(x86_64)
url="https://github.com/Celtic-Bytes/Ducktor"
license=(GPL-3.0-or-later)
depends=(
    qt6-base
    qt6-declarative
    qt6-multimedia
    qt6-svg
)
makedepends=(
    cmake
    git
    ninja
    qt6-base
    qt6-declarative
    qt6-multimedia
    qt6-svg
    qt6-tools
)
source=("https://github.com/Celtic-Bytes/Ducktor/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('32701fa2c6112085d739cc71f21f747e83a1d2be3cd941ff99e737b6e8574ad2')

# The GitHub archive unpacks to a folder named after the repository, not the
# pkgname: Ducktor-<version>, not ducktor-<version>.

build() {
    cd "Ducktor-${pkgver}"
    cmake --preset release
    cmake --build --preset release --parallel
}

package() {
    cd "Ducktor-${pkgver}"
    # cmake --install has no --destdir; the staging directory goes in DESTDIR.
    DESTDIR="${pkgdir}" cmake --install build/release --prefix /usr
}
