# Maintainer: celticbytes <info@celticbytes.com>
#
# Builds Ducktor from source. The inference engines (llama.cpp, whisper.cpp,
# Piper) are cloned and compiled during the build, so it needs network access
# and a while to finish. When a new release tag is cut, bump pkgver and
# recalculate sha256sums from the tarball at
# https://github.com/Celtic-Bytes/Ducktor/archive/refs/tags/v<pkgver>.tar.gz

pkgname=ducktor
pkgver=0.3.1
# pkgrel=1: a fresh tag means a fresh build (no re-package of an existing
# version). Bump pkgrel whenever the build or packaged contents change without
# a new source release (Arch convention), so downstream can detect the
# re-packaged build.
pkgrel=1
pkgdesc="Offline desktop translator for text and voice"
arch=(x86_64)
url="https://github.com/Celtic-Bytes/Ducktor"
license=(GPL-3.0-or-later)
depends=(
    qt6-base
    qt6-declarative
    qt6-multimedia
    qt6-svg
)
makedepends=(
    cmake
    git
    ninja
    qt6-base
    qt6-declarative
    qt6-multimedia
    qt6-svg
    qt6-tools
)
# The only (current) source is the tag tarball; a local pinned source
# (e.g. a backport of a specific vintage) is added here and hashed below.
source=("https://github.com/Celtic-Bytes/Ducktor/archive/refs/tags/v${pkgver}.tar.gz")
# The tarball contains the PKGBUILD itself, so this checksum is only knowable
# once the tag exists: after pushing the tag, download the tarball, compute
# its SHA-256 and replace the sha256sums entry (release procedure step 4 in
# PACKAGING.md). Never bypass the check with --skipchecksums/--skipinteg or
# drop sha256sums.
sha256sums=('60b41c8e8e8f6e623674c858802ab0ebd920d6516dd7829bf76aae5e3c5e9636')

# The GitHub archive unpacks to a folder named after the repository, not the
# pkgname: Ducktor-<version>, not ducktor-<version>.

build() {
    cd "Ducktor-${pkgver}"
    cmake --preset release
    cmake --build --preset release --parallel
}

package() {
    cd "Ducktor-${pkgver}"
    # cmake --install has no --destdir; the staging directory goes in DESTDIR.
    DESTDIR="${pkgdir}" cmake --install build/release --prefix /usr
}
